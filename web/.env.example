# Payload CMS used by `nuxt dev` (local API routes) and `nuxt generate` (prerendering).
# Run `npm run mock:payload` to start a local mock CMS on port 3001.
PAYLOAD_URL=http://localhost:3001
# Optional: Payload API key of a read-only service account, sent as
# "<PAYLOAD_API_KEY_COLLECTION> API-Key <PAYLOAD_API_KEY>".
PAYLOAD_API_KEY=
PAYLOAD_API_KEY_COLLECTION=users
PAYLOAD_CAREERS_COLLECTION=careers
# Only documents with this checkbox ticked are shown. Leave empty to show all.
PAYLOAD_PUBLISHED_FIELD=published
# Set to true only if the careers collection uses drafts/versions (filters on _status).
PAYLOAD_DRAFTS=false

# Public site settings (exposed to the browser).
NUXT_PUBLIC_SITE_NAME=Ignite Hubs Careers Hubs
NUXT_PUBLIC_SITE_URL=
