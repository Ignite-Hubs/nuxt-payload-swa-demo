{
  "name": "ignitehubs-careers-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/index.js --external:@azure/functions",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "func start"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
